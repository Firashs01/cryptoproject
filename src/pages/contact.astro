---
import Layout from '../layouts/Layout.astro';

const title = 'Contact Us | CryptoWords';
const description =
  'Get in touch with the CryptoWords* team. Share feedback, suggest a bot or airdrop, or ask about partnership opportunities.';
const contactEmail = 'earnmoney24625@gmail.com';

const socialLinks = [
  {
    href: 'https://t.me/CryptoWordsF',
    label: 'Telegram',
    icon: `<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>`,
  },
  {
    href: 'https://x.com/HasniFiras4',
    label: 'X / Twitter',
    icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
  },
];
---

<Layout title={title} description={description}>
  <section class="hero">
    <div class="container">
      <span class="hero-kicker">Get in touch</span>
      <h1>Contact <em>Us</em></h1>
      <p>
        Have a bot or airdrop to suggest? Found an issue? Or want to explore partnership opportunities? We would love to hear from you. You can get all updates and try out the latest bot applications and airdrops on Telegram and X.
      </p>
      <a class="btn btn-primary" href={`mailto:${contactEmail}`}>Email us</a>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="contact-heading">Ways to reach us</h2>
          <p>Pick the channel that suits you best — we typically respond within 1–2 business days.</p>
        </div>
        <a class="btn btn-primary" href={`mailto:${contactEmail}`}>Send us an email</a>
      </div>

      <ul class="contact-cards">
        <li class="contact-card">
          <span class="contact-card-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 6-10 7L2 6"></path>
            </svg>
          </span>
          <h3>Email</h3>
          <p>Best for detailed feedback, bug reports and partnership enquiries.</p>
          <a class="contact-card-link" href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </li>

        <li class="contact-card">
          <span class="contact-card-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M22 2 11 13"></path>
              <path d="M22 2 15 22l-4-9-9-4Z"></path>
            </svg>
          </span>
          <h3>Telegram</h3>
          <p>Fastest way to reach us and get live bot and airdrop updates.</p>
          <a class="contact-card-link" href="https://t.me/CryptoWordsF" target="_blank" rel="noopener noreferrer">
            @CryptoWordsF
          </a>
        </li>

        <li class="contact-card">
          <span class="contact-card-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </span>
          <h3>Response hours</h3>
          <p>Messages received outside these hours are answered the next working day.</p>
          <p class="contact-card-meta">Mon–Fri, 9:00–18:00 UTC</p>
        </li>
      </ul>

      <div class="community">
        <div class="community-copy">
          <h2>Follow CryptoWords</h2>
          <p>
            Get bot launches, airdrop alerts and announcements the moment they go live.
          </p>
        </div>
        <ul class="social-pills">
          {
            socialLinks.map((link) => (
              <li>
                <a
                  class="social-pill"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`CryptoWords on ${link.label} (opens in a new tab)`}
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                    set:html={link.icon}
                  ></svg>
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>
