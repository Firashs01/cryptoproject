---
const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/airdrops', label: 'Airdrops' },
  { href: '/airdrops-application', label: 'Airdrops Application' },
  { href: '/contact', label: 'Contact' },
];

const socialLinks = [
  { href: 'https://t.me/CryptoWordsF', label: 'Telegram' },
  { href: 'https://x.com/HasniFiras4', label: 'X / Twitter' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">Crypto<span>Words</span></a>
        <p>
          A curated directory of Telegram bots, airdrops and Web3 opportunities for crypto
          explorers.
        </p>
      </div>

      <div class="footer-col">
        <h2>Navigate</h2>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h2>Community</h2>
        <ul>
          {
            socialLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} CryptoWords*. All rights reserved.</p>
      <p>Built for the Web3 community.</p>
    </div>
  </div>
</footer>
