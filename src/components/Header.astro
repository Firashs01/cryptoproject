---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Bots Telegram' },
  { href: '/airdrops-application', label: 'Airdrops Application' },
  { href: '/airdrops', label: 'Airdrops' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  const clean = href.replace(/\/$/, '') || '/';
  return pathname === clean;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">Crypto<span>Words</span></a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      Menu
    </button>

    <nav class="site-nav" id="primary-nav" aria-label="Primary" data-nav>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
