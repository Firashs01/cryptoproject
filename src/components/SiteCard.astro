---
import { resolveExperienceBorder } from '../lib/experience';

interface Props {
  title: string;
  url: string;
  description: string;
  image: string;
  experience?: string;
}

const { title, url, description, image, experience } = Astro.props;

const borderClass = resolveExperienceBorder(title, experience);
const expValue = (experience && ['safe', 'inexperienced', 'scam'].includes(experience)) ? experience : 'unknown';
const search = `${title} ${description}`.toLowerCase();

function formatImagePath(imagePath: string): string {
  if (!imagePath) return '/images/og-default.webp';
  if (imagePath.startsWith('../')) {
    return imagePath.replace(/^\.\.\//, '/');
  }
  if (!imagePath.startsWith('/') && !imagePath.startsWith('http')) {
    return '/' + imagePath;
  }
  return imagePath;
}

const formattedImage = formatImagePath(image);

const BADGE_CONFIG: Record<string, { label: string; class: string }> = {
  scam: { label: '🚨 SCAM WARNING', class: 'badge--scam' },
  inexperienced: { label: '🟡 Inexperienced', class: 'badge--inexperienced' },
  safe: { label: '🟢 Safe', class: 'badge--safe' },
  unknown: { label: '⚪ Unrated', class: 'badge--unknown' },
};

const badge = BADGE_CONFIG[expValue] || BADGE_CONFIG.unknown;
---

<li class="card-item" data-searchable data-search={search} data-experience={expValue}>
  <article class={`card ${borderClass}`}>
    <div class="card-media">
      <img
        src={formattedImage}
        alt={`${title} website preview`}
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null; this.src='/images/og-default.webp';"
      />
      <div class="card-badge-container">
        <span class={`badge ${badge.class}`}>{badge.label}</span>
      </div>
    </div>
    <div class="card-body">
      <h3>{title}</h3>
      <p>{description}</p>
      <a class="btn btn-primary" href={url} target="_blank" rel="noopener noreferrer">
        Visit Site
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </article>
</li>

<style>
  .card-media {
    position: relative;
  }

  .card-badge-container {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .badge--scam {
    background: rgba(239, 68, 68, 0.22);
    border: 1px solid var(--exp-scam);
    color: #f87171;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .badge--inexperienced {
    background: rgba(234, 179, 8, 0.22);
    border: 1px solid var(--exp-inexperienced);
    color: #facc15;
  }

  .badge--safe {
    background: rgba(34, 197, 94, 0.22);
    border: 1px solid var(--exp-safe);
    color: #4ade80;
  }

  .badge--unknown {
    background: rgba(156, 163, 175, 0.22);
    border: 1px solid var(--exp-unknown);
    color: #d1d5db;
  }
</style>
